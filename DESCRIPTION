Package: MSFR
Title: Multi-Study Factor Regression Model
Version: 0.0.0.9000
Authors@R:
    c(
    person("Roberta", "De Vito", ,"roberta_devito@brown.edu", role = "aut"),
    person("Alejandra", "Avalos-Pacheco", ,"alejandra.avalos_pacheco@jku.at",role = "cre"),
    person("Jörg", "Schantz", role = "ctb")
